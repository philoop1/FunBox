 100:../../DaisySP/Source/Utility/delayline.h ****         int32_t     t     = (write_ptr_ + delay_integral + max_size);
 101:../../DaisySP/Source/Utility/delayline.h ****         const T     xm1   = line_[(t - 1) % max_size];
 102:../../DaisySP/Source/Utility/delayline.h ****         const T     x0    = line_[(t) % max_size];
 103:../../DaisySP/Source/Utility/delayline.h ****         const T     x1    = line_[(t + 1) % max_size];
 104:../../DaisySP/Source/Utility/delayline.h ****         const T     x2    = line_[(t + 2) % max_size];
 105:../../DaisySP/Source/Utility/delayline.h ****         const float c     = (x1 - xm1) * 0.5f;
 106:../../DaisySP/Source/Utility/delayline.h ****         const float v     = x0 - x1;
 107:../../DaisySP/Source/Utility/delayline.h ****         const float w     = c + v;
 108:../../DaisySP/Source/Utility/delayline.h ****         const float a     = w + v + (x2 - x0) * 0.5f;
 109:../../DaisySP/Source/Utility/delayline.h ****         const float b_neg = w + a;
 110:../../DaisySP/Source/Utility/delayline.h ****         const float f     = delay_fractional;
 111:../../DaisySP/Source/Utility/delayline.h ****         return (((a * f) - b_neg) * f + c) * f + x0;
 112:../../DaisySP/Source/Utility/delayline.h ****     }
