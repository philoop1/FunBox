   7:oscillator.cpp **** float Oscillator::Process()
   8:oscillator.cpp **** {
   9:oscillator.cpp ****     float out, t;
  10:oscillator.cpp ****     switch(waveform_)
  11:oscillator.cpp ****     {
  12:oscillator.cpp ****         case WAVE_SIN: out = sinf(phase_ * TWOPI_F); break;
  13:oscillator.cpp ****         case WAVE_TRI:
  14:oscillator.cpp ****             t   = -1.0f + (2.0f * phase_);
  15:oscillator.cpp ****             out = 2.0f * (fabsf(t) - 0.5f);
  16:oscillator.cpp ****             break;
  17:oscillator.cpp ****         case WAVE_SAW: out = -1.0f * (((phase_ * 2.0f)) - 1.0f); break;
  18:oscillator.cpp ****         case WAVE_RAMP: out = ((phase_ * 2.0f)) - 1.0f; break;
  19:oscillator.cpp ****         case WAVE_SQUARE: out = phase_ < pw_ ? (1.0f) : -1.0f; break;
  20:oscillator.cpp ****         case WAVE_POLYBLEP_TRI:
  21:oscillator.cpp ****             t   = phase_;
  22:oscillator.cpp ****             out = phase_ < 0.5f ? 1.0f : -1.0f;
  23:oscillator.cpp ****             out += Polyblep(phase_inc_, t);
  24:oscillator.cpp ****             out -= Polyblep(phase_inc_, fmodf(t + 0.5f, 1.0f));
  25:oscillator.cpp ****             // Leaky Integrator:
  26:oscillator.cpp ****             // y[n] = A + x[n] + (1 - A) * y[n-1]
  27:oscillator.cpp ****             out       = phase_inc_ * out + (1.0f - phase_inc_) * last_out_;
  28:oscillator.cpp ****             last_out_ = out;
  29:oscillator.cpp ****             out *= 4.f; // normalize amplitude after leaky integration
  30:oscillator.cpp ****             break;
  31:oscillator.cpp ****         case WAVE_POLYBLEP_SAW:
ARM GAS  C:\Users\Philoop\AppData\Local\Temp\cctNnENM.s 			page 2


  32:oscillator.cpp ****             t   = phase_;
  33:oscillator.cpp ****             out = (2.0f * t) - 1.0f;
  34:oscillator.cpp ****             out -= Polyblep(phase_inc_, t);
  35:oscillator.cpp ****             out *= -1.0f;
  36:oscillator.cpp ****             break;
  37:oscillator.cpp ****         case WAVE_POLYBLEP_SQUARE:
  38:oscillator.cpp ****             t   = phase_;
  39:oscillator.cpp ****             out = phase_ < pw_ ? 1.0f : -1.0f;
  40:oscillator.cpp ****             out += Polyblep(phase_inc_, t);
  41:oscillator.cpp ****             out -= Polyblep(phase_inc_, fmodf(t + (1.0f - pw_), 1.0f));
  42:oscillator.cpp ****             out *= 0.707f; // ?
  43:oscillator.cpp ****             break;
  44:oscillator.cpp ****         default: out = 0.0f; break;
  45:oscillator.cpp ****     }
  46:oscillator.cpp ****     phase_ += phase_inc_;
  47:oscillator.cpp ****     if(phase_ > 1.0f)
  48:oscillator.cpp ****     {
  49:oscillator.cpp ****         phase_ -= 1.0f;
  50:oscillator.cpp ****         eoc_ = true;
  51:oscillator.cpp ****     }
  52:oscillator.cpp ****     else
  53:oscillator.cpp ****     {
  54:oscillator.cpp ****         eoc_ = false;
  55:oscillator.cpp ****     }
  56:oscillator.cpp ****     eor_ = (phase_ - phase_inc_ < 0.5f && phase_ >= 0.5f);
  57:oscillator.cpp **** 
  58:oscillator.cpp ****     return out * amp_;
  59:oscillator.cpp **** }
