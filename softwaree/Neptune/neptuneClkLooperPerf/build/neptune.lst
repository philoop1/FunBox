  83:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // Red-black tree class, designed for use in implementing STL
  84:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // associative containers (set, multiset, map, and multimap). The
  85:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // insertion and deletion algorithms are based on those in Cormen,
  86:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // Leiserson, and Rivest, Introduction to Algorithms (MIT Press,
  87:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // 1990), except that
  88:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   //
  89:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // (1) the header cell is maintained with links not only to the root
  90:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // but also to the leftmost node of the tree, to enable constant
ARM GAS  C:\Users\Philoop\AppData\Local\Temp\cciq00nI.s 			page 579


  91:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // time begin(), and to the rightmost node of the tree, to enable
  92:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // linear time performance when used with the generic set algorithms
  93:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // (set_union, etc.)
  94:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   //
  95:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // (2) when a node being deleted has two children its successor node
  96:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // is relinked into its place, rather than copied, so that the only
  97:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_tree.h ****   // iterators invalidated are those referring to the deleted node.
