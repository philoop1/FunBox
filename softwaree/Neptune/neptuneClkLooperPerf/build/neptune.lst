 117:neptune.cpp   **** 
 118:neptune.cpp   **** 
 119:neptune.cpp   **** struct delay
 120:neptune.cpp   **** {
 121:neptune.cpp   ****     DelayLineOct<float, MAX_DELAY> *del;
 122:neptune.cpp   ****     DelayLineReverse<float, MAX_DELAY_REV> *delreverse;
 123:neptune.cpp   ****     float                        currentDelay;
 124:neptune.cpp   ****     float                        delayTarget;
 125:neptune.cpp   ****     float                        feedback = 0.0;
 126:neptune.cpp   ****     float                        active = false;
 127:neptune.cpp   ****     bool                         reverseMode = false;
 128:neptune.cpp   ****     float                        level = 1.0;      // Level multiplier of output, added for stereo 
 129:neptune.cpp   ****     float                        level_reverse = 1.0;      // Level multiplier of output, added for
 130:neptune.cpp   ****     bool                         dual_delay = false;
 131:neptune.cpp   ****     bool                         secondTapOn = false;
 132:neptune.cpp   ****     
 133:neptune.cpp   ****     float Process(float in)
 134:neptune.cpp   ****     {
 135:neptune.cpp   ****         //set delay times
 136:neptune.cpp   ****         fonepole(currentDelay, delayTarget, .0002f);
 137:neptune.cpp   ****         del->SetDelay(currentDelay);
 138:neptune.cpp   ****         delreverse->SetDelay1(currentDelay);
 139:neptune.cpp   **** 
 140:neptune.cpp   ****         float del_read = del->Read();
 141:neptune.cpp   **** 
 142:neptune.cpp   ****         float read_reverse = delreverse->ReadRev(); // REVERSE
 143:neptune.cpp   **** 
 144:neptune.cpp   ****         float read = toneOctLP.Process(del_read);  // LP filter, tames harsh high frequencies on oc
 145:neptune.cpp   **** 
 146:neptune.cpp   ****         float secondTap = 0.0;
 147:neptune.cpp   ****         if (secondTapOn) {
 148:neptune.cpp   ****             secondTap = del->ReadSecondTap();
 149:neptune.cpp   ****         }
 150:neptune.cpp   ****         //float read2 = delreverse->ReadFwd();
 151:neptune.cpp   ****         if (active) {
 152:neptune.cpp   ****             const float write = NeptuneSoftLimit((feedback * read) + in);
 153:neptune.cpp   ****             del->Write(write);
 154:neptune.cpp   ****             delreverse->Write(write);  // Writing the read from fwd/oct delay line allows for combi
 155:neptune.cpp   ****             //delreverse->Write((feedback * read2) + in); 
 156:neptune.cpp   ****         } else {
 157:neptune.cpp   ****             const float write = NeptuneSoftLimit(feedback * read);
 158:neptune.cpp   ****             del->Write(write); // if not active, don't write any new sound to buffer
ARM GAS  C:\Users\Philoop\AppData\Local\Temp\cciq00nI.s 			page 280


 159:neptune.cpp   ****             delreverse->Write(write);
 160:neptune.cpp   ****             //delreverse->Write((feedback * read2));
 161:neptune.cpp   ****         }
 162:neptune.cpp   **** 
 163:neptune.cpp   ****         if (dual_delay) {
 164:neptune.cpp   ****             return read_reverse * level_reverse * 0.5 + (read + secondTap) * level * 0.5; // Half t
 165:neptune.cpp   ****         } else if (reverseMode) {
 166:neptune.cpp   ****             return read_reverse * level_reverse;
 167:neptune.cpp   ****         } else {
 168:neptune.cpp   ****             return (read + secondTap) * level;
 169:neptune.cpp   ****         }
 170:neptune.cpp   ****     }
 171:neptune.cpp   **** };
