 103:../CloudSeed/ModulatedAllpass.h **** 		void ProcessWithMod(float* input, int sampleCount)
 104:../CloudSeed/ModulatedAllpass.h **** 		{
 105:../CloudSeed/ModulatedAllpass.h **** 			for (int i = 0; i < sampleCount; i++)
 106:../CloudSeed/ModulatedAllpass.h **** 			{
 107:../CloudSeed/ModulatedAllpass.h **** 				if (samplesProcessed >= ModulationUpdateRate)
 108:../CloudSeed/ModulatedAllpass.h **** 					Update();
 109:../CloudSeed/ModulatedAllpass.h **** 
 110:../CloudSeed/ModulatedAllpass.h **** 				float bufOut;
 111:../CloudSeed/ModulatedAllpass.h **** 
 112:../CloudSeed/ModulatedAllpass.h **** 				if (InterpolationEnabled)
 113:../CloudSeed/ModulatedAllpass.h **** 				{
 114:../CloudSeed/ModulatedAllpass.h **** 					int idxA = index - delayA;
 115:../CloudSeed/ModulatedAllpass.h **** 					int idxB = index - delayB;
 116:../CloudSeed/ModulatedAllpass.h **** 					idxA += DelayBufferSamples * (idxA < 0); // modulo
 117:../CloudSeed/ModulatedAllpass.h **** 					idxB += DelayBufferSamples * (idxB < 0); // modulo
 118:../CloudSeed/ModulatedAllpass.h **** 
 119:../CloudSeed/ModulatedAllpass.h **** 					bufOut = delayBuffer[idxA] * gainA + delayBuffer[idxB] * gainB;
 120:../CloudSeed/ModulatedAllpass.h **** 				}
 121:../CloudSeed/ModulatedAllpass.h **** 				else
 122:../CloudSeed/ModulatedAllpass.h **** 				{
 123:../CloudSeed/ModulatedAllpass.h **** 					int idxA = index - delayA;
 124:../CloudSeed/ModulatedAllpass.h **** 					idxA += DelayBufferSamples * (idxA < 0); // modulo
 125:../CloudSeed/ModulatedAllpass.h **** 					bufOut = delayBuffer[idxA];
 126:../CloudSeed/ModulatedAllpass.h **** 				}
 127:../CloudSeed/ModulatedAllpass.h **** 
 128:../CloudSeed/ModulatedAllpass.h **** 				auto inVal = input[i] + bufOut * Feedback;
 129:../CloudSeed/ModulatedAllpass.h **** 				delayBuffer[index] = inVal;
 130:../CloudSeed/ModulatedAllpass.h **** 				output[i] = bufOut - inVal * Feedback;
 131:../CloudSeed/ModulatedAllpass.h **** 
 132:../CloudSeed/ModulatedAllpass.h **** 				index++;
 133:../CloudSeed/ModulatedAllpass.h **** 				if (index >= DelayBufferSamples) index -= DelayBufferSamples;
 134:../CloudSeed/ModulatedAllpass.h **** 				samplesProcessed++;
 135:../CloudSeed/ModulatedAllpass.h **** 			}
 136:../CloudSeed/ModulatedAllpass.h **** 		}
