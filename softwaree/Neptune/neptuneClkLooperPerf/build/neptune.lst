  45:../../../include/expressionHandler.h ****     {
  46:../../../include/expressionHandler.h ****         float expression_up[6];
  47:../../../include/expressionHandler.h ****         float expression_down[6];
  48:../../../include/expressionHandler.h ****         bool  expression_knob_active[6];
  49:../../../include/expressionHandler.h ****         bool  expressionEngaged;
  50:../../../include/expressionHandler.h ****     };
  51:../../../include/expressionHandler.h **** 
  52:../../../include/expressionHandler.h ****     ExpressionHandler() {}
  53:../../../include/expressionHandler.h ****     ~ExpressionHandler() {}
