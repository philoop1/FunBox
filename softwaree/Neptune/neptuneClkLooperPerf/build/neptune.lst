 111:neptune.cpp   **** #define MAX_DELAY_REV static_cast<size_t>(48000 * 16.0f) // double for reverse
 112:neptune.cpp   **** 
 113:neptune.cpp   **** DelayLineReverse<float, MAX_DELAY_REV> DSY_SDRAM_BSS delayLineRevLeft;
 114:neptune.cpp   **** DelayLineOct<float, MAX_DELAY> DSY_SDRAM_BSS delayLineOctLeft;
 115:neptune.cpp   **** DelayLineReverse<float, MAX_DELAY_REV> DSY_SDRAM_BSS delayLineRevRight;
