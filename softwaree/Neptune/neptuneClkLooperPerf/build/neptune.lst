 353:../CloudSeed/ReverbChannel.h **** 
 354:../CloudSeed/ReverbChannel.h **** 			// completely zero if no input present
 355:../CloudSeed/ReverbChannel.h **** 			// Previously, the very small values were causing some really strange CPU spikes
 356:../CloudSeed/ReverbChannel.h **** 			for (int i = 0; i < len; i++)
 357:../CloudSeed/ReverbChannel.h **** 			{
 358:../CloudSeed/ReverbChannel.h **** 				auto n = tempBuffer[i];
 359:../CloudSeed/ReverbChannel.h **** 				if (n * n < 0.000000001)
 360:../CloudSeed/ReverbChannel.h **** 					tempBuffer[i] = 0;
 361:../CloudSeed/ReverbChannel.h **** 			}
