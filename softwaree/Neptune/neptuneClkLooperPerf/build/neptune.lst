 218:../../../libDaisy/src/hid/midi.h ****         \param byte MIDI byte to be parsed
 219:../../../libDaisy/src/hid/midi.h ****     */
 220:../../../libDaisy/src/hid/midi.h ****     void Parse(uint8_t byte)
