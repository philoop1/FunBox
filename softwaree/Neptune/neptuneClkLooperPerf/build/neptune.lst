  32:../CloudSeed/Utils.h **** 
  33:../CloudSeed/Utils.h **** 		// perform bit crushing and undersampling
  34:../CloudSeed/Utils.h **** 		// undersampling: if set to 1, perfroms no effect, if set to 2, will undersample to 1/2 samplerat
  35:../CloudSeed/Utils.h **** 		// sampleResolution: if set to 32, will use 2^32 steps, if set to 8, will resude to 2^8 = 256 ste
  36:../CloudSeed/Utils.h **** 		// Currently Unused
  37:../CloudSeed/Utils.h **** 		static inline void BitcrushAndReduce(float* bufferIn, float* bufferOut, int len, int undersamplin
  38:../CloudSeed/Utils.h **** 		{
  39:../CloudSeed/Utils.h **** 			float sampleSteps = std::pow(2, sampleResolution);
  40:../CloudSeed/Utils.h **** 			float inverseSteps = 1.0 / sampleSteps;
  41:../CloudSeed/Utils.h **** 
  42:../CloudSeed/Utils.h **** 			float sample = 0.0;
  43:../CloudSeed/Utils.h **** 
  44:../CloudSeed/Utils.h **** 			for (int i = 0; i < len; i++)
  45:../CloudSeed/Utils.h **** 			{
  46:../CloudSeed/Utils.h **** 				if (i % undersampling == 0)
  47:../CloudSeed/Utils.h **** 					sample = ((long)(bufferIn[i] * sampleSteps)) * inverseSteps;
  48:../CloudSeed/Utils.h **** 
  49:../CloudSeed/Utils.h **** 				bufferOut[i] = sample;
  50:../CloudSeed/Utils.h **** 			}
  51:../CloudSeed/Utils.h **** 		}
