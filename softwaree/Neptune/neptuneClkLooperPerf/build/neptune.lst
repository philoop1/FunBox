   9:../../../libDaisy/src/util/PersistentStorage.h **** /** @brief Non Volatile storage class for persistent settings on an external flash device.
  10:../../../libDaisy/src/util/PersistentStorage.h ****  *  @author shensley
  11:../../../libDaisy/src/util/PersistentStorage.h ****  * 
  12:../../../libDaisy/src/util/PersistentStorage.h ****  *  Storage occupied by the struct will be one word larger than 
  13:../../../libDaisy/src/util/PersistentStorage.h ****  *  the SettingStruct used. The extra word is used to store the
  14:../../../libDaisy/src/util/PersistentStorage.h ****  *  state of the data, and whether it's been overwritten or not.
  15:../../../libDaisy/src/util/PersistentStorage.h ****  * 
  16:../../../libDaisy/src/util/PersistentStorage.h ****  *  \todo - Make Save() non-blocking
  17:../../../libDaisy/src/util/PersistentStorage.h ****  *  \todo - Add wear leveling
  18:../../../libDaisy/src/util/PersistentStorage.h ****  * 
  19:../../../libDaisy/src/util/PersistentStorage.h ****  **/
  20:../../../libDaisy/src/util/PersistentStorage.h **** template <typename SettingStruct>
  21:../../../libDaisy/src/util/PersistentStorage.h **** class PersistentStorage
  22:../../../libDaisy/src/util/PersistentStorage.h **** {
  23:../../../libDaisy/src/util/PersistentStorage.h ****   public:
  24:../../../libDaisy/src/util/PersistentStorage.h ****     /** State of the storage. 
  25:../../../libDaisy/src/util/PersistentStorage.h ****      *  When created, prior to initialiation, the state will be Unknown
  26:../../../libDaisy/src/util/PersistentStorage.h ****      *  
  27:../../../libDaisy/src/util/PersistentStorage.h ****      *  During initialization, the state will be changed to either FACTORY,
  28:../../../libDaisy/src/util/PersistentStorage.h ****      *  or USER. 
  29:../../../libDaisy/src/util/PersistentStorage.h ****      * 
  30:../../../libDaisy/src/util/PersistentStorage.h ****      *  If this is the first time these settings are being written to the
  31:../../../libDaisy/src/util/PersistentStorage.h ****      *  target address, the defaults will be written to that location,
  32:../../../libDaisy/src/util/PersistentStorage.h ****      *  and the state will be set to FACTORY.
  33:../../../libDaisy/src/util/PersistentStorage.h ****      * 
  34:../../../libDaisy/src/util/PersistentStorage.h ****      *  Once the first user-trigger save has been made, the state will be 
  35:../../../libDaisy/src/util/PersistentStorage.h ****      *  updated to USER to indicate that the defaults have overwritten.
  36:../../../libDaisy/src/util/PersistentStorage.h ****      */
  37:../../../libDaisy/src/util/PersistentStorage.h ****     enum class State
  38:../../../libDaisy/src/util/PersistentStorage.h ****     {
  39:../../../libDaisy/src/util/PersistentStorage.h ****         UNKNOWN = 0,
  40:../../../libDaisy/src/util/PersistentStorage.h ****         FACTORY = 1,
  41:../../../libDaisy/src/util/PersistentStorage.h ****         USER    = 2,
  42:../../../libDaisy/src/util/PersistentStorage.h ****     };
  43:../../../libDaisy/src/util/PersistentStorage.h **** 
  44:../../../libDaisy/src/util/PersistentStorage.h ****     /** Constructor for storage class 
  45:../../../libDaisy/src/util/PersistentStorage.h ****      *  \param qspi reference to the hardware qspi peripheral.
  46:../../../libDaisy/src/util/PersistentStorage.h ****      */
  47:../../../libDaisy/src/util/PersistentStorage.h ****     PersistentStorage(QSPIHandle &qspi)
  48:../../../libDaisy/src/util/PersistentStorage.h ****     : qspi_(qspi),
  49:../../../libDaisy/src/util/PersistentStorage.h ****       address_offset_(0),
  50:../../../libDaisy/src/util/PersistentStorage.h ****       default_settings_(),
  51:../../../libDaisy/src/util/PersistentStorage.h ****       settings_(),
  52:../../../libDaisy/src/util/PersistentStorage.h ****       state_(State::UNKNOWN)
