 989:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *
 990:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  std::find_if (v.begin(), v.end(), not1(IntGreaterThanThree()));
 991:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  \endcode
 992:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  The call to @c find_if will locate the first index (i) of @c v for which
 993:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  <code>!(v[i] > 3)</code> is true.
 994:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *
 995:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  The not1/unary_negate combination works on predicates taking a single
 996:c:\program files\daisytoolchain\arm-none-eabi\include\c++\10.2.1\bits\stl_function.h ****    *  argument.  The not2/binary_negate combination works on predicates which
