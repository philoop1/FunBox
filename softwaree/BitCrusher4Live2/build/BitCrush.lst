  53:../../libDaisy/src/util/PersistentStorage.h ****     {
  54:../../libDaisy/src/util/PersistentStorage.h ****     }
  55:../../libDaisy/src/util/PersistentStorage.h **** 
  56:../../libDaisy/src/util/PersistentStorage.h ****     /** Initialize Storage class
  57:../../libDaisy/src/util/PersistentStorage.h ****      *
  58:../../libDaisy/src/util/PersistentStorage.h ****      *  The values in this class will be stored as the default
  59:../../libDaisy/src/util/PersistentStorage.h ****      *  for restoration to 'factory' settings.
ARM GAS  C:\Users\Philoop\AppData\Local\Temp\cceo2nvg.s 			page 250


  60:../../libDaisy/src/util/PersistentStorage.h ****      *
  61:../../libDaisy/src/util/PersistentStorage.h ****      *  \param defaults should be a setting structure containing the default values.
  62:../../libDaisy/src/util/PersistentStorage.h ****      *      this will be updated to contain the stored data.
  63:../../libDaisy/src/util/PersistentStorage.h ****      *  \param address_offset offset for location on the QSPI chip (offset to base address of devic
  64:../../libDaisy/src/util/PersistentStorage.h ****      *      This defaults to the first address on the chip, and will be masked to the nearest multi
  65:../../libDaisy/src/util/PersistentStorage.h ****      **/
  66:../../libDaisy/src/util/PersistentStorage.h ****     void Init(const SettingStruct &defaults, uint32_t address_offset = 0)
  67:../../libDaisy/src/util/PersistentStorage.h ****     {
