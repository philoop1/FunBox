  76:../../include/expressionHandler.h ****     void ToggleExpressionSetMode() 
  77:../../include/expressionHandler.h ****     // Toggles Expression Set Mode on/off. When toggling out of Expression Set Mode, the Expression
  78:../../include/expressionHandler.h ****     {
  79:../../include/expressionHandler.h ****         expressionSet = !expressionSet;
  80:../../include/expressionHandler.h ****         expressionEngaged = !expressionSet;
  81:../../include/expressionHandler.h **** 
  82:../../include/expressionHandler.h ****         if (expressionSet) {
  83:../../include/expressionHandler.h ****             //led1_brightness = 0.5f;  // Dim LEDs in expression set mode // Redundant
  84:../../include/expressionHandler.h ****             //led2_brightness = 0.5f;  // Dim LEDs in expression set mode
  85:../../include/expressionHandler.h **** 
  86:../../include/expressionHandler.h ****             // Reset expression_knob_active to all false
  87:../../include/expressionHandler.h ****             std::fill(std::begin(expression_knob_active), std::end(expression_knob_active), false);
  88:../../include/expressionHandler.h **** 
  89:../../include/expressionHandler.h ****         }
  90:../../include/expressionHandler.h **** 
  91:../../include/expressionHandler.h ****         if (expressionEngaged) { // If expression mode has been engaged, check for moved knobs
  92:../../include/expressionHandler.h ****             for (int i = 0; i < numParams; i++) {
  93:../../include/expressionHandler.h ****                 if (knobMoved(expression_up[i], expression_down[i])) {
  94:../../include/expressionHandler.h ****                     expression_knob_active[i] = true;
  95:../../include/expressionHandler.h ****                 } 
  96:../../include/expressionHandler.h ****             }
  97:../../include/expressionHandler.h ****         }
  98:../../include/expressionHandler.h ****     }
  99:../../include/expressionHandler.h **** 
 100:../../include/expressionHandler.h ****     bool isExpressionSetMode() 
 101:../../include/expressionHandler.h ****     {
